# FilesDevxyz — Cloudflare R2 configuration.
# Copy to .env (never commit real values) or set these in Vercel → Project → Settings → Environment Variables.

# Found in Cloudflare dashboard URL: https://dash.cloudflare.com/<ACCOUNT_ID>
R2_ACCOUNT_ID=

# R2 → Manage R2 API Tokens → Create API Token (Object Read & Write on your bucket)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# The R2 bucket name (create it first in the Cloudflare dashboard)
R2_BUCKET=filesdevxyz

# Optional: max single-file size in bytes (default 2GB = 2147483648)
MAX_FILE_SIZE=

# Storage cap in GB — uploads are refused (HTTP 507) before the bucket can
# grow past this, so the R2 free tier is never exceeded. Default 9. Set to 0 to disable.
STORAGE_CAP_GB=9

# Auto-delete: files older than this many days are deleted by /api/cleanup
# (runs daily via Vercel Cron, see vercel.json). Default 7.
RETENTION_DAYS=7

# Long random string. Vercel Cron sends it as Authorization: Bearer <secret>
# on every cron request; /api/cleanup rejects anything else.
CRON_SECRET=

# Optional: public base URL if you later serve files directly (not used by presigned flow)
R2_PUBLIC_BASE=
