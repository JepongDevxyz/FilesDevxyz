# FilesDevxyz — Cloudflare R2 configuration.
# Copy to .env (never commit real values) or set these in Vercel → Project → Settings → Environment Variables.

# Found in Cloudflare dashboard URL: https://dash.cloudflare.com/<ACCOUNT_ID>
R2_ACCOUNT_ID=

# R2 → Manage R2 API Tokens → Create API Token (Object Read & Write on your bucket)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# The R2 bucket name (create it first in the Cloudflare dashboard)
R2_BUCKET=filesdevxyz

# Optional: max single-file size in bytes (default 2GB = 2147483648)
MAX_FILE_SIZE=

# Optional: public base URL if you later serve files directly (not used by presigned flow)
R2_PUBLIC_BASE=
